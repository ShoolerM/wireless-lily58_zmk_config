#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    macros {
        macro_0: macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
        };
        macro_1: macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };
        macro_2: macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
        };
        macro_3: macro_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ASTRK &kp ASTRK &kp LEFT>;
        };
        macro_4: macro_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };
        macro_5: macro_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp UNDER &kp LEFT>;
        };
        macro_6: macro_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp PLUS &kp Y>;
        };
        macro_7: macro_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp PLUS &kp P>;
        };
        macro_8: macro_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
        };
        macro_9: macro_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <
                &kp GRAVE &kp GRAVE &kp GRAVE
                &kp GRAVE &kp GRAVE &kp GRAVE
                &kp LEFT &kp LEFT &kp LEFT
            >;
        };
        macro_10: macro_10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(UP)>;
        };
        macro_11: macro_11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT)>;
        };
        macro_12: macro_12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(DOWN)>;
        };
        macro_13: macro_13 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(RIGHT)>;
        };
        macro_14: macro_14 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT)>;
        };
        macro_15: macro_15 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(RIGHT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp ESC &kp N1 &kp N2 &kp N3
                &kp N4 &kp N5
                &kp N6 &kp N7 &kp N8 &kp N9
                &kp N0 &kp BSPC

                &kp TAB &kp Q &kp W &kp E
                &kp R &kp T
                &kp Y &kp U &kp I &kp O
                &kp P &kp MINUS

                &kp EQUAL &kp A &kp S &kp D
                &kp F &kp G
                &kp H &kp J &kp K &kp L
                &kp SEMI &kp RET

                &kp LSHFT &kp Z &kp X &kp C
                &kp V &kp B &kp LBKT
                &kp RBKT &kp N &kp M &kp COMMA
                &kp DOT &kp FSLH &kp RSHFT

                &kp LGUI &kp LALT &kp LCTRL &mo 1
                &kp SPACE &kp SQT &kp GRAVE &mo 2
            >;
        };

        layer_1 {
            display-name = "Layer 1";
            bindings = <
                &trans &trans &trans &trans
                &kp PG_UP &trans
                &trans &kp PG_UP &macro_3 &macro_4
                &trans &kp DEL

                &trans &trans &trans &kp UP
                &kp PG_DN &trans
                &macro_6 &kp PG_DN &macro_10 &trans
                &macro_7 &kp BSLH

                &kp CAPS &trans &kp LEFT &kp DOWN
                &kp RIGHT &trans
                &trans &macro_11 &macro_12 &macro_13
                &trans &trans

                &trans &trans &trans &trans
                &trans &trans &macro_1
                &macro_2 &trans &trans &trans
                &trans &trans &trans

                &trans &trans &trans &trans
                &trans &macro_8 &macro_9 &none
            >;
        };

        layer_2 {
            display-name = "Layer 2";
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4
                &kp F5 &kp F6
                &kp F7 &kp F8 &kp F9 &kp F10
                &kp F11 &kp F12

                &trans &trans &trans &trans
                &trans &trans
                &trans &trans &trans &trans
                &trans &trans

                &trans &trans &macro_14 &trans
                &macro_15 &trans
                &trans &trans &trans &trans
                &trans &macro_0

                &trans &trans &trans &trans
                &trans &trans &kp PSCRN
                &kp SLCK &trans &trans &trans
                &trans &trans &trans

                &trans &trans &trans &trans
                &trans &trans &trans &trans
            >;
        };

        layer_3 {
            display-name = "Layer 3";
            bindings = <
                &none &none &kp KP_NLCK &kp FSLH
                &kp ASTRK &kp UNDER
                &none &none &none &none
                &none &none

                &none &none &kp N7 &kp N8
                &kp N9 &kp KP_PLUS
                &msc SCRL_UP &mkp LCLK
                &mmv MOVE_UP &mkp RCLK
                &none &none

                &none &none &kp N4 &kp N5
                &kp N6 &kp COMMA
                &msc SCRL_DOWN &mmv MOVE_LEFT
                &mmv MOVE_DOWN &mmv MOVE_RIGHT
                &none &none

                &none &none &kp N1 &kp N2
                &kp N3 &kp EQUAL &none
                &none &none &none &none
                &none &none &none

                &kp N0 &kp KP_DOT &kp KP_ENTER &trans
                &trans &trans &trans &trans
            >;
        };
    };
};
